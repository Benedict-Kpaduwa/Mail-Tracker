# Reference only — deploy/setup.sh generates the real unit at
# /etc/systemd/system/mail-tracker.service with absolute paths filled in.
#
# NOTE: ProtectHome=true below assumes the app lives outside /home (e.g.
# /opt/mail-tracker). If the checkout is under /home, setup.sh instead emits
# ProtectHome=read-only and makes the parent dir traversable, otherwise the
# service can't chdir into its own directory (status=200/CHDIR).

[Unit]
Description=Mail Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailtrack
Group=mailtrack
WorkingDirectory=/opt/mail-tracker
EnvironmentFile=/opt/mail-tracker/.env
ExecStart=/usr/bin/node /opt/mail-tracker/dist/server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/mail-tracker/data /opt/mail-tracker/backups

[Install]
WantedBy=multi-user.target
