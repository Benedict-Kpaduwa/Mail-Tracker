{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/server"],
  "exclude": ["src/dashboard", "extension"]
}
