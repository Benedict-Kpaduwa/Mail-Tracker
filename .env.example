# Public base URL the tracking pixel is served from.
# Local dev: http://localhost:8787
# Real use:  your cloudflared/ngrok tunnel URL, or your deployed URL.
BASE_URL=http://localhost:8787
PORT=8787
# Bind address. Behind a reverse proxy (Caddy/nginx), set HOST=127.0.0.1.
HOST=0.0.0.0

# Shared secret. `npm run init` generates one and writes it here.
# The dashboard and the Chrome extension both authenticate with this.
MAILTRACK_TOKEN=

# SQLite file location.
DB_PATH=./data/mailtrack.db

# Open-detection heuristics (seconds).
# Ignore pixel hits that arrive within this many seconds of send (suppresses
# your own Gmail proxy fetching the image right after you hit send).
SELF_OPEN_WINDOW_SEC=15
# Collapse repeated hits for the same email within this window into one open.
DEDUPE_WINDOW_SEC=120
# When the extension reports the sender opening their own sent mail, ignore
# (and retroactively drop) any open within this many seconds of that moment.
SELF_VIEW_WINDOW_SEC=45

# --- Email digest (optional) ---
DIGEST_ENABLED=false
# cron expression, server local time. Default: 8:00am daily.
DIGEST_CRON=0 8 * * *
DIGEST_TO=benedictkpaduwa@gmail.com
# SMTP for sending the digest. For Gmail use an App Password (NOT your login
# password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
